generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Assignment {
  id           String   @id @default(cuid())
  title        String
  courseCode   String
  type         String
  dueDate      DateTime
  status       String   @default("NOT_STARTED")
  progress     Int      @default(0)
  description  String?
  notes        String?
  groupMembers Json?
  checklist    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WeekEntry {
  id          String   @id @default(cuid())
  courseCode  String
  weekNumber  Int
  topicTitle  String
  covered     String?
  keyConcepts String?
  learned     String?
  profNotes   String?
  confidence  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([courseCode, weekNumber])
}

model CourseNote {
  id         String   @id @default(cuid())
  courseCode String   @unique
  content    String
  updatedAt  DateTime @updatedAt
}

model StudySession {
  id          String   @id @default(cuid())
  date        String // YYYY-MM-DD (CST), denormalised for fast day queries
  courseCode  String // one of the 6 slugs
  durationMin Int
  focus       Int? // 1-5 self-rating
  topic       String? // free-text "what did you study"
  notes       String?
  startedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([courseCode, startedAt])
}

model Note {
  id         String   @id @default(cuid())
  courseCode String? // null = global note
  text       String
  source     String   @default("richie-web") // hermes-ren, etc.
  capturedAt DateTime @default(now())
  pinned     Boolean  @default(false)

  @@index([courseCode, capturedAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityId   String?
  entityType String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([actor, createdAt])
}
